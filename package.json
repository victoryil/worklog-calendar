{
  "name": "worklog-calendar",
  "version": "1.0.0",
  "description": "A React calendar library for worklogs and events.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsup src/index.tsx --dts --format esm,cjs --out-dir dist",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "tsup": "^8.5.0",
    "@types/react": "^17.0.87",
    "@types/react-dom": "^17.0.26"
  }
}